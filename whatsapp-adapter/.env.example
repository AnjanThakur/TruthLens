# Placeholder values only. Copy to .env privately; never paste actual secrets into chat.
BOT_ENV=test
RESPONSE_MODE=development
# Enable only after the owner approves actual WhatsApp sends.
META_OUTBOUND_ENABLED=false
# Enable only after owner approves provider consumption and verifies key rotation.
BACKEND_ENABLED=false
PROVIDER_CREDENTIALS_ROTATED=false
# Only an explicit owner waiver permits testing new keys before old-key revocation.
# This does not confirm revocation and cannot authorize production.
PROVIDER_KEY_REVOCATION_WAIVED=false
# Twilio only: optional actual HX SID copied from Try out WhatsApp.
# A supplied template is a development connectivity test, never a fact-check reply.
TWILIO_DEVELOPMENT_CONTENT_SID=
# Keep twiml for the legacy Sandbox. The newer Try out WhatsApp trial forbids
# direct TwiML XML: explicitly select empty for an instruction-free HTTP 200.
# This changes acknowledgements only; it does not permit dynamic trial replies.
TWILIO_WEBHOOK_ACK_MODE=twiml
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
GRAPH_API_VERSION=
TRUTHLENS_BACKEND_URL=http://127.0.0.1:8000
# For an authenticated gateway; Person 1 itself currently has no bearer-token authentication.
TRUTHLENS_BACKEND_TOKEN=
DATABASE_URL=sqlite:///state/bot.sqlite3
STATE_ENCRYPTION_KEY=
IDENTITY_HASH_SECRET=
SUPPORT_URL=
MAX_MEDIA_BYTES=10485760
MAX_WEBHOOK_BYTES=262144
MAX_QUEUE_JOBS=1000
PER_SENDER_PER_MINUTE=10
CONTENT_RETENTION_HOURS=24
DEDUP_RETENTION_DAYS=8
