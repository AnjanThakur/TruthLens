# Server-only upstream. Never add NEXT_PUBLIC_ to backend credentials.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_TOKEN=
BACKEND_TIMEOUT_MS=60000
# Conservative provisional upload cap; reconcile with Person 1 and hosting limits.
MAX_UPLOAD_BYTES=10485760
# Fixture mode requires BOTH flags; production builds refuse synthetic API responses.
NEXT_PUBLIC_USE_MOCK_API=false
USE_MOCK_API=false
# Optional history. No service-role key is used or needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Server-only random key (at least 32 characters) signing live reports before opt-in save.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HISTORY_SIGNING_SECRET=
# Separate P1 deployment ONLY (documentation placeholders, not consumed by frontend):
# META_WABA_ID=
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
