# Server-only upstream. Never add NEXT_PUBLIC_ to backend credentials.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_TOKEN=
# P1's default deadline is 180 seconds; the host must support this duration.
BACKEND_TIMEOUT_MS=195000
# Conservative provisional upload cap; reconcile with Person 1 and hosting limits.
MAX_UPLOAD_BYTES=10485760
# Fixture mode requires BOTH flags; production builds refuse synthetic API responses.
NEXT_PUBLIC_USE_MOCK_API=false
USE_MOCK_API=false
# Optional history. No service-role key is used or needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Server-only random key (at least 32 characters) signing live reports before opt-in save.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HISTORY_SIGNING_SECRET=
# Separate alerts service and tokens are server-only. Keep the source secret stable.
ALERTS_BASE_URL=http://127.0.0.1:8001
ALERTS_INGEST_TOKEN=
ALERTS_ADMIN_TOKEN=
ALERTS_SOURCE_SECRET=
# Separate P1 deployment ONLY (documentation placeholders, not consumed by frontend):
# META_WABA_ID=
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# META_VERIFY_TOKEN=

# Public number only. Enable after actual number and delivery are verified.
WHATSAPP_LINK_ENABLED=false
WHATSAPP_PUBLIC_NUMBER=
