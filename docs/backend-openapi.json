  "components": {
    "schemas": {
      "Body_extract_api_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PNG/JPEG, PDF, WAV, MP3 or OGG/Opus. Format is detected from bytes, not the filename."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extract_api_extract_post"
      },
      "ClaimResult": {
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid",
            "title": "Claim Id"
          },
          "claim_text": {
            "type": "string",
            "maxLength": 1200,
            "title": "Claim Text"
          },
          "original_span": {
            "type": "string",
            "maxLength": 3000,
            "title": "Original Span"
          },
          "entities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entities"
          },
          "dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dates"
          },
          "qualifiers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Qualifiers"
          },
          "normalized_claim": {
            "type": "string",
            "title": "Normalized Claim"
          },
          "lexical_hash": {
            "type": "string",
            "title": "Lexical Hash"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "verified",
              "false",
              "partially_true",
              "outdated",
              "misleading_context",
              "unconfirmed"
            ],
            "title": "Verdict"
          },
          "grounded_explanation": {
            "type": "string",
            "maxLength": 1800,
            "title": "Grounded Explanation"
          },
          "explanation": {
            "type": "string",
            "maxLength": 2500,
            "title": "Explanation"
          },
          "short_summary": {
            "type": "string",
            "maxLength": 350,
            "title": "Short Summary"
          },
          "key_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Key Points"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Evidence"
          },
          "risk": {
            "$ref": "#/components/schemas/Risk"
          },
          "temporal_context": {
            "$ref": "#/components/schemas/TemporalContext"
          },
          "original_context": {
            "$ref": "#/components/schemas/OriginalContext"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "next_step": {
            "type": "string",
            "title": "Next Step"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim_text",
          "original_span",
          "entities",
          "dates",
          "qualifiers",
          "normalized_claim",
          "lexical_hash",
          "verdict",
          "grounded_explanation",
          "explanation",
          "short_summary",
          "evidence",
          "risk",
          "temporal_context",
          "original_context",
          "limitations",
          "next_step",
          "checked_at"
        ],
        "title": "ClaimResult"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "location",
          "type"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "title": "Title"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Url"
          },
          "publisher": {
            "type": "string",
            "maxLength": 300,
            "title": "Publisher"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "fact_check",
              "other"
            ],
            "title": "Source Type"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "stance": {
            "type": "string",
            "enum": [
              "supports",
              "contradicts",
              "context",
              "neutral",
              "unclear"
            ],
            "title": "Stance",
            "default": "unclear"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 5000,
            "title": "Excerpt"
          },
          "excerpt_provenance": {
            "type": "string",
            "enum": [
              "fetched_page",
              "search_excerpt",
              "fact_check_api"
            ],
            "title": "Excerpt Provenance"
          },
          "what_source_says": {
            "type": "string",
            "title": "What Source Says",
            "default": ""
          },
          "authority_basis": {
            "type": "string",
            "title": "Authority Basis"
          },
          "relevance_score": {
            "type": "number",
            "title": "Relevance Score",
            "default": 0
          },
          "directly_relevant": {
            "type": "boolean",
            "title": "Directly Relevant",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "url",
          "publisher",
          "source_type",
          "retrieved_at",
          "excerpt",
          "excerpt_provenance",
          "authority_basis"
        ],
        "title": "Evidence"
      },
      "ExplainRequest": {
        "properties": {
          "result": {
            "$ref": "#/components/schemas/VerificationResult"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "mr"
            ],
            "title": "Language"
          },
          "audience": {
            "type": "string",
            "enum": [
              "child",
              "teen",
              "adult",
              "senior"
            ],
            "title": "Audience",
            "default": "adult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "result",
          "language"
        ],
        "title": "ExplainRequest"
      },
      "ExtractionResult": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "detected_language": {
            "type": "string",
            "title": "Detected Language"
          },
          "input_type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "pdf",
              "url"
            ],
            "title": "Input Type"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "extraction_details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extraction Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "detected_language",
          "input_type"
        ],
        "title": "ExtractionResult"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "capabilities": {
            "additionalProperties": true,
            "type": "object",
            "title": "Capabilities"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Dependencies"
          },
          "limits": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Limits"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "capabilities",
          "dependencies",
          "limits",
          "notes"
        ],
        "title": "HealthResponse"
      },
      "OriginalContext": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "not_checked",
              "inconclusive",
              "found"
            ],
            "title": "Status",
            "default": "not_checked"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          },
          "source_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Urls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "OriginalContext"
      },
      "Risk": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Level"
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/RiskFactor"
            },
            "type": "array",
            "title": "Factors"
          },
          "is_probability": {
            "type": "boolean",
            "const": false,
            "title": "Is Probability",
            "default": false
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "Forwarding caution heuristic; not a probability that a claim is false."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "score",
          "level",
          "factors"
        ],
        "title": "Risk"
      },
      "RiskFactor": {
        "properties": {
