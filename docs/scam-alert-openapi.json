  "components": {
    "schemas": {
      "AlertDraft": {
        "properties": {
          "alert_id": {
            "type": "string",
            "format": "uuid",
            "title": "Alert Id"
          },
          "cluster_id": {
            "type": "string",
            "format": "uuid",
            "title": "Cluster Id"
          },
          "title": {
            "type": "string",
