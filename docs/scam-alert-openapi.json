              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
