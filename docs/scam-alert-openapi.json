          },
          "claim_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Summary"
          },
          "evidence_based_status": {
            "type": "string",
            "enum": [
              "claim_contradicted",
              "claim_needs_context",
              "suspicious_indicators"
            ],
            "title": "Evidence Based Status"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "scam_warning_signs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scam Warning Signs"
          },
          "recommended_user_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommended User Actions"
          },
          "authoritative_source_links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authoritative Source Links"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "mr"
            ],
            "title": "Language"
          },
          "language_content_status": {
            "type": "string",
            "enum": [
              "ready",
              "pending_translation"
            ],
            "title": "Language Content Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_verified_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Verified At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "approval_status": {
            "type": "string",
            "enum": [
              "draft",
              "pending_review",
              "approved",
              "rejected",
              "expired"
            ],
            "title": "Approval Status",
            "default": "draft"
          },
          "content_version": {
            "type": "integer",
            "title": "Content Version",
            "default": 1
          },
          "evidence_fingerprint": {
            "type": "string",
            "title": "Evidence Fingerprint"
          },
          "review": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Review"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_history": {
            "items": {
              "$ref": "#/components/schemas/Review"
            },
            "type": "array",
            "title": "Review History"
          },
          "scope_note": {
            "type": "string",
            "title": "Scope Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cluster_id",
          "title",
          "claim_summary",
          "evidence_based_status",
          "explanation",
          "scam_warning_signs",
          "recommended_user_actions",
          "authoritative_source_links",
          "language",
          "language_content_status",
          "created_at",
          "last_verified_at",
          "expires_at",
          "evidence_fingerprint",
          "scope_note"
        ],
        "title": "AlertDraft"
      },
      "ApproveRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "reviewer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reviewer Id"
          },
          "evidence_reviewed": {
            "type": "boolean",
            "const": true,
            "title": "Evidence Reviewed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "reviewer_id",
          "evidence_reviewed"
        ],
        "title": "ApproveRequest"
      },
      "ClaimResult": {
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid",
            "title": "Claim Id"
          },
          "claim_text": {
            "type": "string",
            "maxLength": 1200,
            "title": "Claim Text"
          },
          "original_span": {
            "type": "string",
            "maxLength": 3000,
            "title": "Original Span"
          },
          "entities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entities"
          },
          "dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dates"
          },
          "qualifiers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Qualifiers"
          },
          "normalized_claim": {
            "type": "string",
            "title": "Normalized Claim"
          },
          "lexical_hash": {
            "type": "string",
            "title": "Lexical Hash"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "verified",
              "false",
              "partially_true",
              "outdated",
              "misleading_context",
              "unconfirmed"
            ],
            "title": "Verdict"
          },
          "grounded_explanation": {
            "type": "string",
            "maxLength": 1800,
            "title": "Grounded Explanation"
          },
          "explanation": {
            "type": "string",
            "maxLength": 2500,
            "title": "Explanation"
          },
          "short_summary": {
            "type": "string",
            "maxLength": 350,
            "title": "Short Summary"
          },
          "key_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Key Points"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Evidence"
          },
          "risk": {
            "$ref": "#/components/schemas/Risk"
          },
          "temporal_context": {
            "$ref": "#/components/schemas/TemporalContext"
          },
          "original_context": {
            "$ref": "#/components/schemas/OriginalContext"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "next_step": {
            "type": "string",
            "title": "Next Step"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim_text",
          "original_span",
          "entities",
          "dates",
          "qualifiers",
          "normalized_claim",
          "lexical_hash",
          "verdict",
          "grounded_explanation",
          "explanation",
          "short_summary",
          "evidence",
          "risk",
          "temporal_context",
          "original_context",
          "limitations",
          "next_step",
          "checked_at"
        ],
        "title": "ClaimResult"
      },
      "Cluster": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "format": "uuid",
            "title": "Cluster Id"
          },
          "canonical_claim": {
            "type": "string",
            "title": "Canonical Claim"
          },
          "first_observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "First Observed At"
          },
          "last_observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Observed At"
          },
          "unique_submission_count": {
            "type": "integer",
            "title": "Unique Submission Count",
            "default": 0
          },
          "similar_observed_submissions": {
            "items": {
              "$ref": "#/components/schemas/ObservedClaim"
            },
            "type": "array",
            "title": "Similar Observed Submissions"
          },
          "evidence_references": {
            "items": {
              "$ref": "#/components/schemas/EvidenceReference"
            },
            "type": "array",
            "title": "Evidence References"
          },
          "status": {
            "type": "string",
            "enum": [
              "observing",
              "recurring",
              "increasing",
              "deferred",
              "review_available"
            ],
            "title": "Status",
            "default": "observing"
          },
          "trend": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Trend"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "canonical_claim",
          "first_observed_at",
          "last_observed_at"
        ],
        "title": "Cluster"
      },
      "DraftRequest": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "mr"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DraftRequest"
      },
      "EditRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "claim_summary": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Claim Summary"
          },
          "explanation": {
            "type": "string",
            "maxLength": 1800,
            "minLength": 1,
            "title": "Explanation"
          },
          "translation_reviewed": {
            "type": "boolean",
