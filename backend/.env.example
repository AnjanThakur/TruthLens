# Copy to backend/.env; never store keys in this template or commit them.
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Empty uses GEMINI_MODEL for audio too.
GEMINI_AUDIO_MODEL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
EXTERNAL_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=180
PROVIDER_MAX_ATTEMPTS=2
# Daily quota errors never retry; short transient guidance uses this wait budget.
PROVIDER_MAX_RETRY_WAIT_SECONDS=3
VERIFICATION_CACHE_TTL_SECONDS=120
VERIFICATION_CACHE_ENTRIES=32
DOCUMENT_CHUNK_CHARS=6000
MAX_DOCUMENT_CHUNKS=8
SOURCE_EXCERPT_CHARS=3000
# Optional LLM_TIMEOUT_SECONDS and URL_TIMEOUT_SECONDS override EXTERNAL_TIMEOUT_SECONDS.
MAX_PROMPT_CHARS=65000
MAX_UPLOAD_BYTES=10485760
MAX_URL_BYTES=2097152
MAX_TEXT_CHARS=24000
MAX_PDF_PAGES=8
MAX_CLAIMS=8
MAX_EVIDENCE=6
VERIFY_CONCURRENCY=2
SEARCH_DEPTH=basic
MAX_SEARCH_QUERIES_PER_CLAIM=1
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_CACHE_ENTRIES=128
TESSERACT_CMD=
TESSDATA_DIR=
OCR_LANGUAGES=eng+hin+mar
FFMPEG_CMD=
FFPROBE_CMD=
MAX_AUDIO_SECONDS=300

# Optional isolated alerts service; all three secrets distinct and at least 32 chars.
# No Gemini/Tavily keys required by the alert engine. Do not expose these to browsers.
ALERTS_INGEST_TOKEN=
ALERTS_ADMIN_TOKEN=
ALERTS_PSEUDONYM_SECRET=
ALERTS_MIN_INDEPENDENT_SUBMISSIONS=3
ALERTS_TREND_WINDOW_HOURS=24
ALERTS_BASELINE_DAYS=7
ALERTS_GROWTH_RATIO=2
ALERTS_EVIDENCE_MAX_AGE_HOURS=48
ALERTS_DRAFT_TTL_HOURS=12
ALERTS_RETENTION_DAYS=14
ALERTS_PURGE_INTERVAL_SECONDS=60
ALERTS_MAX_OBSERVATIONS=5000
ALERTS_MAX_CLUSTERS=1000
ALERTS_MAX_DRAFTS=2000
ALERTS_EMBEDDING_SIMILARITY=0.93
